+/* 2026: after a mode change, move the desktop window back onto the
+   screen if any of it (title bar and all) is now off it, the top left
+   first: going from a big desktop (RoMac full screen) to a small one left
+   it out of reach. At the first null event after the change (from
+   SDL_riscosevents.c): the Wimp's own Open_Window_Requests for the new
+   mode come after Message_ModeChange and would put it back. */
+void
+RISCOS_WimpKeepOnScreen(_THIS)
+{
+    SDL_VideoData *vdata = (SDL_VideoData *) _this->driverdata;
+    int xeig = RISCOS_WimpReadEig(4), yeig = RISCOS_WimpReadEig(5);
+    int scr_w = RISCOS_WimpScreenSize(11) << xeig, scr_h = RISCOS_WimpScreenSize(12) << yeig;
+    RISCOS_WindowState state;
+    struct { int window; RISCOS_Box box; } outline;
+    _kernel_swi_regs regs;
+    int dx = 0, dy = 0;
+
+    state.open.window = vdata->wimp_window;
+    regs.r[1] = (int)&state;
+    if (_kernel_swi(Wimp_GetWindowState, &regs, &regs) != NULL)
+        return;
+    outline.window = vdata->wimp_window;
+    regs.r[1] = (int)&outline;
+    if (_kernel_swi(Wimp_GetWindowOutline, &regs, &regs) != NULL)
+        return;
+    if (outline.box.x1 > scr_w)
+        dx = scr_w - outline.box.x1;
+    if (outline.box.x0 + dx < 0)
+        dx = -outline.box.x0;
+    if (outline.box.y0 < 0)
+        dy = -outline.box.y0;
+    if (outline.box.y1 + dy > scr_h)
+        dy = scr_h - outline.box.y1;
+    if (dx || dy) {
+        RISCOS_WimpOpenAt(vdata->wimp_window, state.open.visible.x0 + dx, state.open.visible.y1 + dy,
+                          state.open.visible.x1 - state.open.visible.x0,
+                          state.open.visible.y1 - state.open.visible.y0);
+        vdata->rel_discard = SDL_TRUE;     /* the middle moved: not a move */
+    }
+}
+
