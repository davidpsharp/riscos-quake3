+/* 2026: an Info field's value: the hint, but the website without its
+   "https://", so that it fits. */
+static const char *
+RISCOS_InfoValue(const char *hint)
+{
+    const char *v = SDL_GetHint(hint);
+    if (v && SDL_strcmp(hint, "SDL_RISCOS_APP_WEBSITE") == 0) {
+        if (SDL_strncmp(v, "https://", 8) == 0)
+            v += 8;
+        else if (SDL_strncmp(v, "http://", 7) == 0)
+            v += 7;
+    }
+    return v;
+}
+
+/* 2026: opens SDL_RISCOS_APP_WEBSITE in a web browser: through the URI
+   module if it's loaded (it isn't on every RISC OS 5); else by broadcasting
+   Message_URL to a running browser; if that comes back unclaimed (event 19),
+   RISCOS_WebsiteNotTaken starts one through the URLOpen_ alias a browser
+   sets when the Filer sees it. */
+#define RISCOS_MESSAGE_URL 0x4AF80
+
+static void
+RISCOS_OpenWebsite(int task)
+{
+    const char *url = SDL_GetHint("SDL_RISCOS_APP_WEBSITE");
+    _kernel_swi_regs regs;
+    RISCOS_Message message;
+
+    if (!url || !*url || SDL_strlen(url) >= sizeof(message.data))
+        return;
+    regs.r[0] = 0;
+    regs.r[1] = (int)url;
+    regs.r[2] = task;
+    if (_kernel_swi(0x4E381 /* URI_Dispatch */, &regs, &regs) == NULL)
+        return;
+    SDL_zero(message);
+    SDL_strlcpy((char *)message.data, url, sizeof(message.data));
+    message.size = (20 + (int)SDL_strlen(url) + 1 + 3) & ~3;
+    message.action = RISCOS_MESSAGE_URL;
+    regs.r[0] = 18;                     /* User_Message_Recorded */
+    regs.r[1] = (int)&message;
+    regs.r[2] = 0;                      /* to every task */
+    _kernel_swi(Wimp_SendMessage, &regs, &regs);
 }
 
+static void
+RISCOS_WebsiteNotTaken(void)
+{
+    const char *url = SDL_GetHint("SDL_RISCOS_APP_WEBSITE");
+    char alias[40], command[300];
+    struct { int number; char text[252]; } error;
+    _kernel_swi_regs regs;
+    size_t scheme;
+
+    if (!url)
+        return;
+    scheme = SDL_strchr(url, ':') ? (size_t)(SDL_strchr(url, ':') - url) : 0;
+    if (scheme > 0 && scheme < 16) {
+        SDL_snprintf(alias, sizeof(alias), "Alias$URLOpen_%.*s", (int)scheme, url);
+        if (_kernel_getenv(alias, command, sizeof(command)) == NULL) {
+            SDL_snprintf(command, sizeof(command), "URLOpen_%.*s %s", (int)scheme, url, url);
+            regs.r[0] = (int)command;
+            if (_kernel_swi(Wimp_StartTask, &regs, &regs) == NULL)
+                return;
+        }
+    }
+    error.number = 0;
+    SDL_snprintf(error.text, sizeof(error.text),
+                 "No web browser is running or known to the Filer. The website is %s", url);
+    regs.r[0] = (int)&error;
+    regs.r[1] = 1;                      /* OK */
+    regs.r[2] = (int)RISCOS_AppName();
+    _kernel_swi(Wimp_ReportError, &regs, &regs);
+}
