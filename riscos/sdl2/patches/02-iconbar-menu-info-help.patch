+/* A choice from the icon bar menu. Adjust keeps the menu open. */
+static void
+RISCOS_IconbarMenuSelection(_THIS, const int *selection)
+{
+    _kernel_swi_regs regs;
+    int mouse[5];
+
+    if (selection[0] < 0 || selection[0] > 2)
+        return;
+    switch (riscos_menu_items[selection[0]]) {
+    case RISCOS_MENU_HELP: {
+        const char *help = RISCOS_HelpPath();
+        if (help) {
+            char command[320];
+            SDL_snprintf(command, sizeof(command), "Filer_Run %s", help);
+            _kernel_oscli(command);
+        }
+        break;
+    }
+    case RISCOS_MENU_QUIT:
+        RISCOS_ForgetShutdown();
+        SDL_SendQuit();
+        return;
+    default:
+        break;
+    }
+    regs.r[1] = (int)mouse;
+    if (_kernel_swi(Wimp_GetPointerInfo, &regs, &regs) == NULL && (mouse[2] & 1)) {
+        regs.r[1] = (int)riscos_iconbar_menu;
+        _kernel_swi(Wimp_CreateMenu, &regs, &regs);
+    }
 }
 
