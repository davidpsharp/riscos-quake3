+/* The program's !Help, or NULL. */
+static const char *
+RISCOS_HelpPath(void)
+{
+    static char path[300];
+    _kernel_swi_regs regs;
+    const char *dir = RISCOS_AppDir();
+    if (!dir || !*dir)
+        return NULL;
+    SDL_snprintf(path, sizeof(path), "%s.!Help", dir);
+    regs.r[0] = 17;                     /* OS_File 17: read catalogue information */
+    regs.r[1] = (int)path;
+    if (_kernel_swi(OS_File, &regs, &regs) != NULL || regs.r[0] == 0)
+        return NULL;
+    return path;
+}
