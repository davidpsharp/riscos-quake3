+    h = 8 + 60 * rows;
+    block.visible[0] = 392; block.visible[1] = 628;
+    block.visible[2] = 392 + 192 + w; block.visible[3] = 628 + h;
+    block.behind = -1;
+    block.flags = 0x84000012;           /* moveable, auto-redraw, title bar, new format */
+    SDL_memcpy(block.colours, colours, sizeof(colours));
+    block.extent[1] = -h;
+    block.extent[2] = 192 + w;
+    block.title_flags = 0x0000013D;     /* text, border, centred, filled, indirected */
+    block.sprite_area = 1;
+    block.title_buffer = title;
+    block.title_validation = (const char *)-1;
+    block.title_length = sizeof(title);
+    block.icon_count = 2 * rows;
+    regs.r[1] = (int)&block;
+    if (_kernel_swi(Wimp_CreateWindow, &regs, &regs) != NULL)
