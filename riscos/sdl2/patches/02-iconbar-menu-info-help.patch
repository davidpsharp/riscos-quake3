+        unsigned int button_type;
+        int sprite_area;
+        short min_w, min_h;
+        const char *title_buffer;
+        const char *title_validation;
+        int title_length;
+        int icon_count;
+        RISCOS_InfoIcon icons[10];
+    } block;
+    static const unsigned char colours[8] = { 7, 2, 7, 1, 12, 14, 12, 0 };
+    _kernel_swi_regs regs;
+    int i, rows = 0, h, w = 476;
+
+    if (riscos_info_window != -1 && riscos_info_task == task)
+        return riscos_info_window;
+
+    SDL_memset(&block, 0, sizeof(block));
+    /* the fields are as wide as the longest value (16 OS units a character
+       in the desktop font, and a margin) */
+    for (i = 0; i < 5; i++) {
+        const char *v = i == 0 ? RISCOS_AppName() : SDL_GetHint(hints[i]);
+        if (v)
+            w = SDL_max(w, 16 * (int)SDL_strlen(v) + 48);
+    }
+    for (i = 0; i < 5; i++) {
+        const char *v = i == 0 ? RISCOS_AppName() : SDL_GetHint(hints[i]);
+        int top = -4 - 60 * rows;
+        if (!v || !*v)
+            continue;
+        SDL_strlcpy(values[i], v, sizeof(values[i]));
+        block.icons[2 * rows].x0 = 184; block.icons[2 * rows].y0 = top - 52;
+        block.icons[2 * rows].x1 = 184 + w; block.icons[2 * rows].y1 = top;
+        block.icons[2 * rows].flags = 0x1700613D;  /* text, border, filled, indirected, centred */
+        block.icons[2 * rows].buffer = values[i];
+        block.icons[2 * rows].validation = field_valid;
+        block.icons[2 * rows].length = (int)SDL_strlen(values[i]) + 1;
+        block.icons[2 * rows + 1].x0 = 8; block.icons[2 * rows + 1].y0 = top - 48;
+        block.icons[2 * rows + 1].x1 = 184; block.icons[2 * rows + 1].y1 = top - 8;
+        block.icons[2 * rows + 1].flags = 0x17000311;  /* text, right aligned, indirected */
+        block.icons[2 * rows + 1].buffer = labels[i];
